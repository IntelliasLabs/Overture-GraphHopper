// Bus model for an Overture import. To use it, add bus_access to graph.encoded_values and:
//
// profiles:
//    - name: bus
//      custom_model_files: [bus_overture.json]
//
// This is the Overture counterpart to bus.json, and differs from it in two ways.
//
// First, bus.json opens with
//     { "if": "max_weight < 5 || max_width < 3 || max_height < 4", "multiply_by": "0" }
// which an Overture import must not use. Overture carries no weight or height data at all, and its
// width rules are not yet collected, so those encoded values would sit at their storage default of 0
// on every edge - and 0 reads as "a 0 tonne limit", not "unknown". The clause would therefore zero the
// priority of every edge in the graph and no bus route would ever be found. The dimension check
// returns here when Overture dimension data does.
//
// Second, road_class == BUSWAY is left out of the priority list. RoadClass.BUSWAY exists upstream, but
// OvertureRoadClass has no busway value, so an Overture import can never produce it and the clause
// would be permanently false.
//
// Speed comes from car_average_speed, exactly as in bus.json: buses are motor vehicles and Overture
// has no bus-specific speed source.

{
  "distance_influence": 90,
  "priority": [
    { "if": "bus_access && (road_class == MOTORWAY || road_class == TRUNK || road_class == PRIMARY || road_class == SECONDARY || road_class == TERTIARY || road_class == UNCLASSIFIED || road_class == LIVING_STREET || road_class == RESIDENTIAL || road_class == SERVICE || road_class == ROAD)",
      "multiply_by": "1"
    },
    { "else": "", "multiply_by": "0" }
  ],
  "speed": [
    { "if": "bus_access && car_average_speed < 10", "limit_to": "10" },
    { "else": "", "limit_to": "car_average_speed * 0.9" },
    { "if": "true", "limit_to": "100" }
  ]
}
