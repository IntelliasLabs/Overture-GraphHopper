// Car model for an Overture import, the counterpart to car.json.
//
// It differs from car.json in one line. car.json ends its speed rules with
//     { "if": "true", "limit_to": "max_speed * 0.9" }
// which an Overture import cannot use today: the Overture reader never writes max_speed, so the
// encoded value sits at its storage default of 0 on every edge and that clause limits every edge to
// 0 km/h - no route is ever found. Note that 0 is not "unknown" here; MaxSpeed.MAXSPEED_MISSING is
// positive infinity, so an unwritten value is indistinguishable from a real limit of zero.
//
// Once the reader fills max_speed, delete this file and use car.json.

{
  "distance_influence": 90,
  "priority": [
    { "if": "!car_access", "multiply_by": "0" }
  ],
  "speed": [
    { "if": "road_environment == FERRY", "limit_to": "ferry_speed" },
    { "else": "", "limit_to": "car_average_speed" }
  ]
}
